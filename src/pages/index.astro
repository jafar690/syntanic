---
import Layout from '../layouts/Layout.astro';
import CtaSection from '../components/CtaSection.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import { Image } from 'astro:assets';
import imgMykii     from '../assets/work/mykii.png';
import imgSaleszote from '../assets/work/saleszote.png';
---

<Layout>

  <!-- HERO -->
  <section id="hero" class="relative min-h-svh flex flex-col justify-between pt-24 overflow-hidden">
    <!-- Radial glow -->
    <div class="absolute top-0 right-0 w-1/2 h-full bg-[radial-gradient(ellipse_70%_60%_at_80%_30%,rgba(255,138,59,0.05)_0%,transparent_70%)] pointer-events-none"></div>

    <div class="flex-1 max-w-320 w-full mx-auto px-6 sm:px-10 grid grid-cols-1 lg:grid-cols-2 gap-10 items-center py-12">

      <!-- Left: text -->
      <div>
        <div class="inline-flex items-center gap-2 font-mono text-xs tracking-widest uppercase text-accent mb-8 opacity-0 [animation:fadeUp_0.5s_ease_0.1s_forwards]">
          <span class="w-[7px] h-[7px] bg-accent rounded-full [animation:blink_2s_ease-in-out_infinite]"></span>
          Available for new projects
        </div>

        <h1 class="font-display font-extrabold leading-[0.95] tracking-display text-cream flex flex-col mb-8"
            style="font-size: clamp(2.4rem, 4vw, 4.8rem)">
          <span class="block opacity-0 [animation:fadeUp_0.65s_cubic-bezier(0.22,1,0.36,1)_0.2s_forwards]">Meet your new</span>
          <span class="block text-accent italic opacity-0 [animation:fadeUp_0.65s_cubic-bezier(0.22,1,0.36,1)_0.35s_forwards]">product development</span>
          <span class="block opacity-0 [animation:fadeUp_0.65s_cubic-bezier(0.22,1,0.36,1)_0.5s_forwards]">department.</span>
        </h1>

        <div class="flex flex-col gap-6 opacity-0 [animation:fadeUp_0.65s_ease_0.65s_forwards]">
          <p class="font-body font-light text-lg leading-[1.7] text-muted max-w-100">
            Full-stack product engineering for startups and scale-ups. From idea to production.
          </p>
          <div class="flex items-center gap-5">
            <a href="/contact" class="inline-flex items-center gap-2 px-7 py-3 bg-accent hover:bg-accent-dark text-bg font-display font-bold text-base rounded-full transition-colors duration-200 no-underline shadow-[0_2px_16px_rgba(255,138,59,0.25)] hover:shadow-[0_6px_24px_rgba(255,138,59,0.35)] hover:-translate-y-px active:translate-y-0">
              Start a project
            </a>
            <a href="#work" class="inline-flex items-center gap-2 font-display font-medium text-base text-muted hover:text-cream transition-colors duration-200 no-underline">
              See our work ↓
            </a>
          </div>
        </div>
      </div>

      <!-- Right: floating product dashboard illustration -->
      <div class="hidden lg:flex items-center justify-center opacity-0 [animation:fadeUp_0.8s_ease_0.3s_forwards]">
        <div class="relative w-full max-w-130">

          <!-- Main dashboard window -->
          <div class="rounded-2xl overflow-hidden border border-white/15 shadow-[0_32px_80px_rgba(0,0,0,0.6)]">

            <!-- Window chrome -->
            <div class="flex items-center gap-3 px-4 py-3 bg-[#363634] border-b border-white/8">
              <div class="flex gap-1.5">
                <div class="w-3 h-3 rounded-full bg-[#ff5f57]"></div>
                <div class="w-3 h-3 rounded-full bg-[#febc2e]"></div>
                <div class="w-3 h-3 rounded-full bg-[#28c840]"></div>
              </div>
              <div class="flex-1 mx-3 bg-[#2a2a28] rounded px-3 py-1 flex items-center gap-2">
                <div class="w-2.5 h-2.5 rounded-full border border-white/20"></div>
                <span class="font-mono text-xs text-muted/70">app.client.io — dashboard</span>
              </div>
            </div>

            <!-- App body -->
            <div class="bg-[#282826] flex" style="min-height: 300px;">

              <!-- Sidebar -->
              <div class="w-12 bg-[#1e1e1c] border-r border-white/8 py-4 flex flex-col items-center gap-3 shrink-0">
                <div class="w-7 h-7 rounded-lg bg-accent flex items-center justify-center">
                  <span class="font-display font-extrabold text-bg leading-none" style="font-size: 9px;">S</span>
                </div>
                <div class="mt-2 flex flex-col gap-2.5">
                  <div class="w-7 h-7 rounded-lg bg-accent/15 flex items-center justify-center">
                    <div class="w-3.5 h-3.5 rounded-sm bg-accent/60"></div>
                  </div>
                  {[0,1,2].map(() => (
                    <div class="w-7 h-7 rounded-lg flex items-center justify-center">
                      <div class="w-3.5 h-3.5 rounded-sm bg-white/15"></div>
                    </div>
                  ))}
                </div>
              </div>

              <!-- Content area -->
              <div class="flex-1 p-5 overflow-hidden">
                <!-- Header row -->
                <div class="flex items-center justify-between mb-5">
                  <div>
                    <div class="w-28 h-3 bg-white/25 rounded mb-1.5"></div>
                    <div class="w-16 h-2 bg-white/12 rounded"></div>
                  </div>
                  <div class="flex gap-2">
                    <div class="w-16 h-7 rounded-lg bg-white/8 border border-white/12"></div>
                    <div class="w-20 h-7 rounded-lg bg-accent"></div>
                  </div>
                </div>

                <!-- Metric cards -->
                <div class="grid grid-cols-3 gap-2.5 mb-4">
                  {[
                    { val: '$2.4M', sub: '↑ 18%',  color: '#38c1ad' },
                    { val: '99.9%', sub: 'Uptime',  color: '#ff8a3b' },
                    { val: '48K',   sub: '↑ Users', color: '#5bc1e1' },
                  ].map(s => (
                    <div class="rounded-xl bg-[#323230] border border-white/8 p-3">
                      <div class="w-12 h-1.5 bg-white/12 rounded mb-2.5"></div>
                      <div class="font-display font-extrabold text-cream mb-1" style="font-size: 1.05rem;">{s.val}</div>
                      <span class="font-mono text-xs" style={`color: ${s.color};`}>{s.sub}</span>
                    </div>
                  ))}
                </div>

                <!-- Chart -->
                <div class="rounded-xl bg-[#323230] border border-white/8 p-4">
                  <div class="flex justify-between items-center mb-3">
                    <div class="w-24 h-2.5 bg-white/20 rounded"></div>
                    <div class="flex gap-1.5">
                      <span class="font-mono text-xs px-2 py-0.5 rounded bg-white/8 text-muted/60">1W</span>
                      <span class="font-mono text-xs px-2 py-0.5 rounded bg-accent/20 text-accent">1M</span>
                      <span class="font-mono text-xs px-2 py-0.5 rounded bg-white/8 text-muted/60">3M</span>
                    </div>
                  </div>
                  <svg width="100%" height="68" viewBox="0 0 360 68" preserveAspectRatio="none">
                    <defs>
                      <linearGradient id="chartFill" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="#ff8a3b" stop-opacity="0.3"/>
                        <stop offset="100%" stop-color="#ff8a3b" stop-opacity="0"/>
                      </linearGradient>
                    </defs>
                    <path d="M0 52 C40 47,70 35,110 30 S185 16,225 20 S295 10,360 6 L360 68 L0 68Z" fill="url(#chartFill)"/>
                    <path d="M0 52 C40 47,70 35,110 30 S185 16,225 20 S295 10,360 6" stroke="#ff8a3b" stroke-width="2" fill="none" stroke-linejoin="round"/>
                    <path d="M0 58 C60 54,105 48,155 43 S255 36,305 32 S345 26,360 24" stroke="#38c1ad" stroke-width="1.5" fill="none" opacity="0.6"/>
                    <circle cx="110" cy="30" r="3" fill="#ff8a3b"/>
                    <circle cx="225" cy="20" r="3" fill="#ff8a3b"/>
                    <circle cx="360" cy="6"  r="3" fill="#ff8a3b"/>
                  </svg>
                </div>
              </div>

            </div>
          </div>

          <!-- Floating badge: Deployed -->
          <div class="absolute -top-3 -right-4 flex items-center gap-2 bg-[#0f2a24] border border-teal/30 rounded-xl px-4 py-2.5 shadow-[0_8px_32px_rgba(0,0,0,0.5),0_0_16px_rgba(56,193,173,0.15)]">
            <div class="w-2 h-2 rounded-full bg-teal shrink-0" style="box-shadow: 0 0 8px #38c1ad;"></div>
            <span class="font-mono text-xs text-teal tracking-[0.07em]">DEPLOYED · v2.4.1</span>
          </div>

          <!-- Floating badge: Performance -->
          <div class="absolute -bottom-3 -left-4 flex items-center gap-3 bg-[#2e2e2c] border border-white/12 rounded-xl px-4 py-3 shadow-[0_8px_32px_rgba(0,0,0,0.5)]">
            <div>
              <div class="font-mono text-xs text-muted/60 mb-0.5">Performance</div>
              <div class="font-display font-extrabold text-cream" style="font-size: 1.1rem; line-height: 1;">98 / 100</div>
            </div>
            <div class="w-9 h-9 rounded-full border-2 border-accent/50 flex items-center justify-center shrink-0">
              <span class="font-mono text-xs text-accent font-bold">A+</span>
            </div>
          </div>

        </div>
      </div>

    </div>

    <!-- Stats bar -->
    <div class="flex flex-wrap items-center gap-x-8 gap-y-4 px-6 sm:px-10 py-5 sm:py-6 border-t border-white/8 bg-bg2 opacity-0 [animation:fadeUp_0.6s_ease_1s_forwards]">
      <div class="flex items-center gap-8">
        <div class="flex flex-col gap-0.5">
          <span class="font-display font-extrabold text-2xl text-cream leading-none tracking-[-0.03em]">48+</span>
          <span class="font-mono text-xs tracking-[0.08em] uppercase text-muted">Projects shipped</span>
        </div>
        <div class="w-px h-9 bg-white/8 shrink-0"></div>
        <div class="flex flex-col gap-0.5">
          <span class="font-display font-extrabold text-2xl text-cream leading-none tracking-[-0.03em]">7yr</span>
          <span class="font-mono text-xs tracking-[0.08em] uppercase text-muted">In business</span>
        </div>
        <div class="w-px h-9 bg-white/8 shrink-0"></div>
        <div class="flex flex-col gap-0.5">
          <span class="font-display font-extrabold text-2xl text-cream leading-none tracking-[-0.03em]">100%</span>
          <span class="font-mono text-xs tracking-[0.08em] uppercase text-muted">Client retention</span>
        </div>
      </div>
      <div class="flex flex-wrap gap-2 sm:ml-auto">
        {['React', 'Node.js', 'TypeScript', 'Next.js', 'AWS', 'PostgreSQL'].map(t => (
          <span class="px-3 py-1 bg-surface text-muted border border-white/8 rounded-full font-mono text-xs tracking-[0.04em]">{t}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section id="services" class="py-16 lg:py-28 bg-latte">
    <div class="max-w-320 mx-auto px-6 sm:px-10">

      <!-- Section header -->
      <div class="flex items-end justify-between mb-14 gap-8">
        <div>
          <p class="font-mono text-xs tracking-label uppercase text-[#8a8068] mb-4">01 — Services</p>
          <h2 class="font-display font-extrabold text-bg tracking-display leading-none" style="font-size: clamp(2.8rem, 5.5vw, 5rem)">
            What we<br /><em class="italic text-accent">do well</em>
          </h2>
        </div>
        <p class="font-body font-light text-lg text-[#8a8068] max-w-xs text-right hidden lg:block leading-relaxed">
          Seven capabilities, one cohesive team. Pick one or stack them all.
        </p>
      </div>
      <!-- end header -->

      <!-- BENTO GRID — responsive: 1 col mobile / 2 col tablet / 6 col desktop -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-3 auto-rows-auto">

        <!-- ─── ROW 1 ─────────────────────────────────────────── -->

        <!-- 01 Product Development — large dark featured card -->
        <div class="col-span-1 md:col-span-2 lg:col-span-4 bg-bg rounded-2xl p-10 flex flex-col justify-between min-h-85 group cursor-pointer hover:bg-[#2a2a28] transition-colors duration-300 relative overflow-hidden">
          <!-- Subtle dot-grid background texture -->
          <div class="absolute inset-0 opacity-[0.04]" style="background-image: radial-gradient(circle, #fff 1px, transparent 1px); background-size: 24px 24px;"></div>
          <!-- Hover arrow -->
          <div class="absolute top-6 right-6 sm:top-8 sm:right-8 w-9 h-9 rounded-full border border-white/15 flex items-center justify-center text-white/30 group-hover:text-accent group-hover:border-accent/50 transition-colors duration-300">
            <ArrowIcon />
          </div>
          <div class="relative">
            <span class="font-mono text-xs tracking-widest text-accent/70 block mb-5">01</span>
            <h3 class="font-display font-extrabold text-cream leading-none tracking-[-0.03em] mb-5" style="font-size: clamp(2rem, 3.5vw, 2.75rem)">Product<br/>Development</h3>
            <p class="font-body font-light text-lg leading-[1.7] text-[#8a8580] max-w-md">We build all of our projects using a single tech stack including Laravel (backend), Nuxt.js/Vue.js (frontend), Flutter (mobile apps).</p>
          </div>
          <div class="relative flex items-end justify-between mt-6">
            <div class="flex gap-2 flex-wrap">
              {['Laravel', 'Vue.js / Nuxt', 'Flutter', 'REST APIs'].map(t => (
                <span class="px-3 py-1 bg-white/8 text-white/40 border border-white/10 rounded-full font-mono text-xs tracking-wide">{t}</span>
              ))}
            </div>
            <!-- Illustration -->
            <svg width="80" height="62" viewBox="0 0 72 56" fill="none" class="shrink-0 opacity-70 group-hover:opacity-100 transition-opacity duration-300">
              <rect x="22" y="4"  width="28" height="13" rx="5" fill="#ff8a3b"/>
              <rect x="14" y="21" width="44" height="13" rx="5" fill="#38c1ad"/>
              <rect x="6"  y="38" width="60" height="13" rx="5" fill="#f7f4e4" opacity="0.6"/>
            </svg>
          </div>
        </div>

        <!-- 02 API Integrations — dark teal compact card -->
        <div class="col-span-1 lg:col-span-2 rounded-2xl p-9 flex flex-col justify-between min-h-85 group cursor-pointer transition-colors duration-300 relative overflow-hidden bg-[#0b2622]">
          <!-- Teal glow -->
          <div class="absolute bottom-0 left-0 right-0 h-40 opacity-30" style="background: radial-gradient(ellipse at 50% 100%, #38c1ad 0%, transparent 70%);"></div>
          <div class="relative">
            <span class="font-mono text-xs tracking-widest block mb-5" style="color: #38c1ad; opacity: 0.6">02</span>
            <!-- Large centered illustration -->
            <div class="flex justify-center my-6">
              <svg width="120" height="60" viewBox="0 0 120 60" fill="none">
                <circle cx="20" cy="30" r="16" fill="#38c1ad" opacity="0.2"/>
                <circle cx="20" cy="30" r="16" stroke="#38c1ad" stroke-width="2"/>
                <circle cx="20" cy="30" r="7" fill="#38c1ad"/>
                <circle cx="40" cy="30" r="4" fill="#38c1ad" opacity="0.5"/>
                <circle cx="60" cy="30" r="4" fill="#38c1ad" opacity="0.35"/>
                <circle cx="80" cy="30" r="4" fill="#38c1ad" opacity="0.5"/>
                <circle cx="100" cy="30" r="16" fill="#38c1ad" opacity="0.2"/>
                <circle cx="100" cy="30" r="16" stroke="#38c1ad" stroke-width="2"/>
                <circle cx="100" cy="30" r="7" fill="#38c1ad"/>
              </svg>
            </div>
            <h3 class="font-display font-extrabold leading-tight tracking-[-0.03em] text-2xl mt-4" style="color: #a8e8e0;">API Integrations</h3>
          </div>
          <p class="font-body font-light text-base leading-[1.7] relative" style="color: #5a9e98;">We pride ourselves on clean, well-tested integrations that are reliable and keep data in sync. APIs we've worked with include Google, Facebook, Okta, Stripe, and Salesforce.</p>
        </div>

        <!-- ─── ROW 2 ─────────────────────────────────────────── -->

        <!-- 03 UI/UX Design — warm yellow light card, tall -->
        <div class="col-span-1 lg:col-span-2 rounded-2xl p-9 flex flex-col justify-between group cursor-pointer transition-colors duration-300 relative overflow-hidden bg-[#fffbee] min-h-90">
          <div class="absolute top-0 left-0 right-0 h-1 bg-yellow opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-t-2xl"></div>
          <div>
            <span class="font-mono text-xs tracking-widest text-[#c49a00] block mb-5">03</span>
            <svg width="68" height="54" viewBox="0 0 72 56" fill="none" class="mb-6">
              <rect x="6"  y="4"  width="60" height="42" rx="6" fill="#ffb715" opacity="0.12"/>
              <rect x="6"  y="4"  width="60" height="11" rx="6" fill="#ffb715"/>
              <rect x="6"  y="12" width="60" height="3"  fill="#ffb715"/>
              <rect x="14" y="24" width="22" height="4"  rx="2" fill="#ffb715" opacity="0.7"/>
              <rect x="14" y="32" width="36" height="4"  rx="2" fill="#ffb715" opacity="0.4"/>
              <rect x="14" y="40" width="14" height="4"  rx="2" fill="#ffb715" opacity="0.3"/>
            </svg>
            <h3 class="font-display font-extrabold text-bg text-2xl tracking-[-0.03em] leading-tight mb-4">UI/UX Design</h3>
            <p class="font-body font-light text-lg leading-[1.7] text-[#7a7060]">Our process focuses on distilling complex ideas into easy-to-understand diagrams, wireframes, and final products — user-centered and function-focused designs every time.</p>
          </div>
          <div class="mt-4 inline-flex items-center gap-2 text-[#c49a00] font-display font-semibold text-sm group-hover:gap-3 transition-[color,gap] duration-200">
            Learn more
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2 10L10 2M10 2H4M10 2V8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
        </div>

        <!-- 04 Design Implementation — dark wide card with pixel texture -->
        <div class="col-span-1 md:col-span-2 lg:col-span-4 bg-bg rounded-2xl p-10 flex flex-col justify-between group cursor-pointer hover:bg-[#2a2a28] transition-colors duration-300 relative overflow-hidden min-h-90">
          <!-- Cyan pixel dot pattern bleeds from right -->
          <div class="absolute right-0 top-0 bottom-0 w-56 opacity-20 pointer-events-none">
            <svg width="100%" height="100%" viewBox="0 0 200 360" fill="none" preserveAspectRatio="xMaxYMid slice">
              <circle cx="20"  cy="24"  r="5" fill="#5bc1e1" opacity="0.9"/>
              <circle cx="46"  cy="24"  r="5" fill="#5bc1e1" opacity="0.78"/>
              <circle cx="72"  cy="24"  r="5" fill="#5bc1e1" opacity="0.66"/>
              <circle cx="98"  cy="24"  r="5" fill="#5bc1e1" opacity="0.54"/>
              <circle cx="124" cy="24"  r="5" fill="#5bc1e1" opacity="0.42"/>
              <circle cx="150" cy="24"  r="5" fill="#5bc1e1" opacity="0.30"/>
              <circle cx="176" cy="24"  r="5" fill="#5bc1e1" opacity="0.18"/>
              <circle cx="20"  cy="60"  r="5" fill="#5bc1e1" opacity="0.9"/>
              <circle cx="46"  cy="60"  r="5" fill="#5bc1e1" opacity="0.78"/>
              <circle cx="72"  cy="60"  r="5" fill="#5bc1e1" opacity="0.66"/>
              <circle cx="98"  cy="60"  r="5" fill="#5bc1e1" opacity="0.54"/>
              <circle cx="124" cy="60"  r="5" fill="#5bc1e1" opacity="0.42"/>
              <circle cx="150" cy="60"  r="5" fill="#5bc1e1" opacity="0.30"/>
              <circle cx="176" cy="60"  r="5" fill="#5bc1e1" opacity="0.18"/>
              <circle cx="20"  cy="96"  r="5" fill="#5bc1e1" opacity="0.9"/>
              <circle cx="46"  cy="96"  r="5" fill="#5bc1e1" opacity="0.78"/>
              <circle cx="72"  cy="96"  r="5" fill="#5bc1e1" opacity="0.66"/>
              <circle cx="98"  cy="96"  r="5" fill="#5bc1e1" opacity="0.54"/>
              <circle cx="124" cy="96"  r="5" fill="#5bc1e1" opacity="0.42"/>
              <circle cx="150" cy="96"  r="5" fill="#5bc1e1" opacity="0.30"/>
              <circle cx="176" cy="96"  r="5" fill="#5bc1e1" opacity="0.18"/>
              <circle cx="20"  cy="132" r="5" fill="#5bc1e1" opacity="0.9"/>
              <circle cx="46"  cy="132" r="5" fill="#5bc1e1" opacity="0.78"/>
              <circle cx="72"  cy="132" r="5" fill="#5bc1e1" opacity="0.66"/>
              <circle cx="98"  cy="132" r="5" fill="#5bc1e1" opacity="0.54"/>
              <circle cx="124" cy="132" r="5" fill="#5bc1e1" opacity="0.42"/>
              <circle cx="150" cy="132" r="5" fill="#5bc1e1" opacity="0.30"/>
              <circle cx="176" cy="132" r="5" fill="#5bc1e1" opacity="0.18"/>
              <circle cx="20"  cy="168" r="5" fill="#5bc1e1" opacity="0.9"/>
              <circle cx="46"  cy="168" r="5" fill="#5bc1e1" opacity="0.78"/>
              <circle cx="72"  cy="168" r="5" fill="#5bc1e1" opacity="0.66"/>
              <circle cx="98"  cy="168" r="5" fill="#5bc1e1" opacity="0.54"/>
              <circle cx="124" cy="168" r="5" fill="#5bc1e1" opacity="0.42"/>
              <circle cx="150" cy="168" r="5" fill="#5bc1e1" opacity="0.30"/>
              <circle cx="176" cy="168" r="5" fill="#5bc1e1" opacity="0.18"/>
              <circle cx="20"  cy="204" r="5" fill="#5bc1e1" opacity="0.9"/>
              <circle cx="46"  cy="204" r="5" fill="#5bc1e1" opacity="0.78"/>
              <circle cx="72"  cy="204" r="5" fill="#5bc1e1" opacity="0.66"/>
              <circle cx="98"  cy="204" r="5" fill="#5bc1e1" opacity="0.54"/>
              <circle cx="124" cy="204" r="5" fill="#5bc1e1" opacity="0.42"/>
              <circle cx="150" cy="204" r="5" fill="#5bc1e1" opacity="0.30"/>
              <circle cx="176" cy="204" r="5" fill="#5bc1e1" opacity="0.18"/>
              <circle cx="20"  cy="240" r="5" fill="#5bc1e1" opacity="0.9"/>
              <circle cx="46"  cy="240" r="5" fill="#5bc1e1" opacity="0.78"/>
              <circle cx="72"  cy="240" r="5" fill="#5bc1e1" opacity="0.66"/>
              <circle cx="98"  cy="240" r="5" fill="#5bc1e1" opacity="0.54"/>
              <circle cx="124" cy="240" r="5" fill="#5bc1e1" opacity="0.42"/>
              <circle cx="150" cy="240" r="5" fill="#5bc1e1" opacity="0.30"/>
              <circle cx="176" cy="240" r="5" fill="#5bc1e1" opacity="0.18"/>
              <circle cx="20"  cy="276" r="5" fill="#5bc1e1" opacity="0.9"/>
              <circle cx="46"  cy="276" r="5" fill="#5bc1e1" opacity="0.78"/>
              <circle cx="72"  cy="276" r="5" fill="#5bc1e1" opacity="0.66"/>
