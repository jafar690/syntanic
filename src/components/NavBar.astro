---
---

<nav id="nav" class="fixed top-0 left-0 right-0 z-50 py-5 border-b border-transparent transition-colors duration-300 data-[scrolled]:bg-[rgba(36,36,35,0.94)] data-[scrolled]:backdrop-blur-[16px] data-[scrolled]:border-b-white/8">
  <div class="max-w-320 mx-auto px-6 sm:px-10 flex items-center justify-between gap-8">
    <a href="/" class="flex items-center gap-2 no-underline text-cream font-display font-bold text-base tracking-tight">
      <span class="inline-flex items-center justify-center w-7 h-7 bg-accent text-bg font-display font-extrabold text-sm rounded-md leading-none">S</span>
      Syntanic
    </a>
    <ul class="hidden md:flex list-none gap-10">
      <li><a href="/about" class="text-muted hover:text-cream font-display font-medium text-base transition-colors duration-200 no-underline">About</a></li>
      <li><a href="/#work" class="text-muted hover:text-cream font-display font-medium text-base transition-colors duration-200 no-underline">Work</a></li>
    </ul>
    <div class="flex items-center gap-3">
      <a href="/contact" class="inline-flex items-center px-5 py-2 bg-accent hover:bg-accent-dark text-bg font-display font-bold text-xs rounded-full transition-colors duration-200 no-underline shadow-[0_2px_12px_rgba(255,138,59,0.25)] hover:shadow-[0_4px_20px_rgba(255,138,59,0.35)] hover:-translate-y-px active:translate-y-0">
        Contact us
      </a>
      <button id="menu-btn" class="md:hidden flex flex-col justify-center items-center w-9 h-9 gap-[5px] rounded-lg border border-white/10 hover:border-white/20 transition-colors duration-200" aria-label="Open menu" aria-expanded="false">
        <span class="block w-4 h-px bg-cream transition-transform duration-300 origin-center" id="bar1"></span>
        <span class="block w-4 h-px bg-cream transition-transform duration-300 origin-center" id="bar2"></span>
      </button>
    </div>
  </div>
</nav>

<!-- Mobile menu drawer -->
<div id="mobile-menu" class="fixed inset-0 z-[60] pointer-events-none" aria-hidden="true">
  <div id="menu-backdrop" class="absolute inset-0 bg-bg/80 backdrop-blur-sm opacity-0 transition-opacity duration-300"></div>
  <div id="menu-drawer" class="absolute top-0 right-0 bottom-0 w-72 bg-[#1e1e1d] border-l border-white/8 flex flex-col translate-x-full transition-transform duration-300 ease-[cubic-bezier(0.22,1,0.36,1)]">
    <div class="flex items-center justify-between px-6 py-5 border-b border-white/8">
      <a href="/" class="flex items-center gap-2 no-underline text-cream font-display font-bold text-base tracking-tight">
        <span class="inline-flex items-center justify-center w-7 h-7 bg-accent text-bg font-display font-extrabold text-sm rounded-md leading-none">S</span>
        Syntanic
      </a>
      <button id="menu-close" class="w-8 h-8 flex items-center justify-center text-muted hover:text-cream transition-colors duration-200" aria-label="Close menu">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M2 2l12 12M14 2L2 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      </button>
    </div>
    <nav class="flex flex-col px-6 py-8 gap-1">
      <a href="/about" class="font-display font-semibold text-xl text-muted hover:text-cream transition-colors duration-200 no-underline py-3 border-b border-white/6">About</a>
      <a href="/#work" class="font-display font-semibold text-xl text-muted hover:text-cream transition-colors duration-200 no-underline py-3 border-b border-white/6">Work</a>
      <a href="/contact" class="font-display font-semibold text-xl text-muted hover:text-cream transition-colors duration-200 no-underline py-3">Contact</a>
    </nav>
    <div class="mt-auto px-6 pb-10">
      <a href="/contact" class="flex items-center justify-center gap-2 w-full px-6 py-3.5 bg-accent hover:bg-accent-dark text-bg font-display font-bold text-base rounded-full no-underline transition-colors duration-200 shadow-[0_2px_16px_rgba(255,138,59,0.25)]">
        Start a project
        <svg width="13" height="13" viewBox="0 0 14 14" fill="none"><path d="M2.5 11.5L11.5 2.5M11.5 2.5H5M11.5 2.5V9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>
  </div>
</div>

<script>
  const nav = document.getElementById('nav');
  window.addEventListener('scroll', () => {
    nav?.toggleAttribute('data-scrolled', window.scrollY > 60);
  }, { passive: true });

  const menuBtn      = document.getElementById('menu-btn')!;
  const menuClose    = document.getElementById('menu-close')!;
  const mobileMenu   = document.getElementById('mobile-menu')!;
  const menuDrawer   = document.getElementById('menu-drawer')!;
  const menuBackdrop = document.getElementById('menu-backdrop')!;
  const bar1 = document.getElementById('bar1')!;
  const bar2 = document.getElementById('bar2')!;

  function openMenu() {
    mobileMenu.classList.remove('pointer-events-none');
    mobileMenu.setAttribute('aria-hidden', 'false');
    menuBackdrop.classList.replace('opacity-0', 'opacity-100');
    menuDrawer.classList.remove('translate-x-full');
    menuBtn.setAttribute('aria-expanded', 'true');
    bar1.style.transform = 'translateY(5.5px) rotate(45deg)';
    bar2.style.transform = 'translateY(-5.5px) rotate(-45deg)';
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    mobileMenu.classList.add('pointer-events-none');
    mobileMenu.setAttribute('aria-hidden', 'true');
    menuBackdrop.classList.replace('opacity-100', 'opacity-0');
    menuDrawer.classList.add('translate-x-full');
    menuBtn.setAttribute('aria-expanded', 'false');
    bar1.style.transform = '';
    bar2.style.transform = '';
    document.body.style.overflow = '';
  }

  menuBtn.addEventListener('click', openMenu);
  menuClose.addEventListener('click', closeMenu);
  menuBackdrop.addEventListener('click', closeMenu);
  menuDrawer.querySelectorAll('a').forEach(a => a.addEventListener('click', closeMenu));
</script>
