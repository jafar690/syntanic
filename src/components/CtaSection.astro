---
interface Props {
  href?: string;
  label?: string;
}
const { href = '/contact', label = 'Start a project' } = Astro.props;
---

<section class="py-0 bg-bg">
  <div class="relative max-w-175 mx-auto px-10 py-20 lg:py-36 text-center overflow-hidden">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-150 h-100 bg-[radial-gradient(ellipse,rgba(255,138,59,0.07)_0%,transparent_70%)] pointer-events-none"></div>
    <p class="font-mono text-xs tracking-label uppercase text-muted mb-8">Get in touch</p>
    <h2 class="font-display font-extrabold text-cream tracking-display leading-[0.95] mb-6" style="font-size: clamp(3rem, 7vw, 6.5rem)">
      Let's build<br /><em class="italic text-accent">something great</em>
    </h2>
    <p class="font-body font-light text-lg leading-[1.7] text-muted mb-10">Tell us about your project. We'll respond within 24 hours.</p>
    <a href={href} class="inline-flex items-center gap-2 px-9 py-4 bg-accent hover:bg-accent-dark text-bg font-display font-bold text-lg rounded-full transition-[background-color,box-shadow,transform] duration-200 no-underline shadow-[0_2px_16px_rgba(255,138,59,0.25)] hover:shadow-[0_6px_24px_rgba(255,138,59,0.35)] hover:-translate-y-px active:translate-y-0">
      {label}
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
        <path d="M2.5 11.5L11.5 2.5M11.5 2.5H5M11.5 2.5V9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
  </div>
</section>
